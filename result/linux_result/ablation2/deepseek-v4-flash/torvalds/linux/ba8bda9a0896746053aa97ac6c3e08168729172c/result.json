      "file": "drivers/net/virtio_net.c",
      "lineno": 3357,
      "content": "skb_orphan(skb);",
      "confidence": 1.0
    },
    {
      "file": "drivers/net/virtio_net.c",
      "lineno": 3358,
      "content": "nf_reset_ct(skb);",
      "confidence": 1.0
    }
  ],
